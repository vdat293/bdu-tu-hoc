# Caddy trên EC2 production (bdu-tu-hoc).
#
# Domain đi qua Cloudflare proxy (orange cloud), SSL/TLS mode = Full (strict),
# nên origin phải trình một chứng chỉ hợp lệ cho `sv.bdu.io.vn`: dùng
# Cloudflare Origin Certificate đặt ở `deploy/caddy/certs/` (không commit).
#
# Caddy nhận TTL 80/443 và chuyển HẾT request (static + /api + WebSocket) về
# `bdu-hub:3000`. Caddy tự xử lý Upgrade cho WebSocket, không cần cấu hình thêm.
sv.bdu.io.vn {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	reverse_proxy bdu-hub:3000
}
