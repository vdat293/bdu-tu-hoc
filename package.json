    "test:community-post-editing": "node scripts/run-explicit-suite.mjs tests/test-community-post-editing-integration.js",
    "test:clan-join": "node scripts/run-explicit-suite.mjs tests/test-clan-join-and-permissions.js",
    "test:clan-feed": "node scripts/run-explicit-suite.mjs tests/test-clan-feed-and-documents.js",
    "test:achievement": "node scripts/run-explicit-suite.mjs tests/test-achievement-integration.js",
    "test:learning-interactions": "node scripts/run-explicit-suite.mjs tests/test-learning-interactions.js",
    "test:permission": "node scripts/run-explicit-suite.mjs tests/test-permission-rbac.js",
    "test:confession-hierarchy": "node scripts/run-explicit-suite.mjs tests/test-confession-delete-hierarchy.js",
