  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@tanstack/react-query": "^5.90.2",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "chart.js": "^4.5.0",
    "cheerio": "1.0.0",
    "chess.js": "^1.4.0",
    "discord.js": "^14.27.0",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.34.5",
    "tough-cookie": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
