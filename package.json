    "test:wordfmt-structure": "node scripts/run-safe-tests.mjs --only tests/test-docx-tabular-paste.js --only tests/test-docx-structure.js",
    "test:wordfmt-graduation": "node scripts/run-safe-tests.mjs --only tests/test-docx-graduation.js --only tests/test-wordfmt-document-type-ui.js --only tests/test-wordfmt-cover-customizations.js"
