{
  "name": "bdu-grade-viewer",
  "version": "1.0.0",
  "description": "Ứng dụng tra cứu bảng điểm sinh viên BDU - Đại học Bình Dương",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run db:migrate && node --watch server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --config vite.config.js",
    "build:client": "vite build --config vite.config.js",
    "preview:client": "vite preview --config vite.config.js",
    "lint:frontend": "eslint client vite.config.js",
    "test:frontend": "vitest run --config vitest.config.js",
    "test:e2e": "npm run build:client && node tests/e2e-routing-smoke.js",
    "db:setup:dev": "node scripts/setup-dev-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:dump": "node scripts/db-dump.js",
    "db:restore": "node scripts/db-restore.js",
    "rankings:sync": "node scripts/sync-rankings.js",
    "test": "node tests/test-queue.js && node tests/test-docx-postprocessor.js && node tests/test-docx-structure.js && node tests/test-docx-graduation.js && node tests/test-wordfmt-document-type-ui.js && node tests/test-english-exercise.js && node tests/test-bdu-grades.js && node tests/test-bdu-schedule.js && node tests/test-learning-hub.js && node tests/test-achievements.js && node tests/test-identity-presentation.js && node tests/test-profile-service.js && node tests/test-academic-ranking.js && node tests/test-leaderboard-ui.js && node tests/test-session-toast.js && node tests/test-profile-render.js && node tests/test-grade-table-layout.js && node tests/test-no-mock-data.js && node tests/test-confession-ui.js && node tests/test-clan-document-share-ui.js && node tests/test-community-features.js && node tests/test-avatar-override.js && node tests/test-ranking-frames.js && node tests/test-admin-tool-flow.js && node tests/test-identity-catalog-crud.js && node tests/test-new-identity-titles.js",
    "test:ranking-integration": "node tests/test-ranking-integration.js",
    "test:wordfmt-e2e": "node tests/test-wordfmt-e2e.js",
    "test:achievement-integration": "node tests/test-achievement-integration.js",
    "test:student-clan": "node tests/test-student-clan.js",
    "test:clan-management": "node tests/test-clan-management.js",
    "test:clan-join-permissions": "node tests/test-clan-join-and-permissions.js",
    "test:permission-rbac": "node tests/test-permission-rbac.js",
    "test:clan-feed-docs": "node tests/test-clan-feed-and-documents.js",
    "test:clan-polls": "node tests/test-clan-polls.js",
    "test:clan-quiz": "node tests/test-clan-quiz.js",
    "test:community": "node tests/test-community.js && node tests/test-community-realtime-upgrade.js",
    "test:learning-interactions": "node tests/test-learning-interactions.js",
    "test:load": "node tests/test-server-load.js",
    "test:wordfmt-structure": "node tests/test-docx-structure.js",
    "test:wordfmt-graduation": "node tests/test-docx-graduation.js && node tests/test-wordfmt-document-type-ui.js && node tests/test-wordfmt-cover-customizations.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "chart.js": "^4.5.0",
    "cheerio": "1.0.0",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.34.5",
    "tough-cookie": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
