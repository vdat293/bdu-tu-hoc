    "test:e2e": "node scripts/run-explicit-suite.mjs --build tests/e2e-routing-smoke.js",
    "db:setup:dev": "node scripts/setup-dev-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:baseline": "node scripts/migrate-baseline.js",
    "db:migration:fingerprint": "node scripts/migration-fingerprint.js",
    "db:dump": "node scripts/db-dump.js",
    "db:restore": "node scripts/db-restore.js",
    "rankings:sync": "node scripts/sync-rankings.js",
