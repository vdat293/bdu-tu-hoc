# Production Docker Compose PostgreSQL settings.
# Use a URL-safe password because it is embedded in DATABASE_URL.
POSTGRES_DB=bdu_hub
POSTGRES_USER=bdu_hub
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# PostgreSQL (local npm run dev)
DATABASE_URL=postgresql://bdu_hub:replace-this-password@localhost:5432/bdu_hub
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Tài khoản dịch vụ chỉ đọc dữ liệu CDS BDU. Không dùng tài khoản sinh viên.
CDS_USER=
CDS_PASSWORD=
CDS_INSECURE_TLS=false

# Snapshot xếp hạng chạy mỗi ngày lúc 03:00 Asia/Ho_Chi_Minh.
RANKING_SYNC_ENABLED=true
RANKING_SYNC_HOUR=3
RANKING_SYNC_TIMEOUT_MS=180000
RANKING_MIN_STUDENT_COUNT=100

# Tùy chọn: khóa mới nhất; bỏ trống để tự nhận diện, tối thiểu K29.
RANKING_LATEST_COHORT=
