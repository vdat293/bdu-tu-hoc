# Production Docker Compose PostgreSQL settings.
# Use a URL-safe password because it is embedded in DATABASE_URL.
POSTGRES_DB=bdu_hub
POSTGRES_USER=bdu_hub
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# PostgreSQL (local npm run dev)
DATABASE_URL=postgresql://bdu_hub:replace-this-password@localhost:5432/bdu_hub
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
SYSTEM_OWNER_MSSV=
AVATAR_STORAGE_DIR=./data/avatars
AVATAR_MAX_SIZE_MB=3

# WebSocket: giữ trống khi frontend cùng origin. Với frontend ở origin khác,
# liệt kê origin công khai, ngăn cách bằng dấu phẩy (ví dụ https://hub.example.edu.vn).
WS_ALLOWED_ORIGINS=
# Chỉ bật khi cổng Node chỉ nhận traffic từ reverse proxy tin cậy. Proxy phải
# chuyển tiếp X-Forwarded-Host hoặc header Forwarded có host công khai.
WS_TRUST_PROXY=
# Thời gian chờ client gửi auth trước khi đóng socket. Một lần xác thực đang
# gọi BDU vẫn được phép hoàn tất; lỗi BDU tạm thời sẽ trả 1013 để client retry.
WS_AUTH_TIMEOUT_MS=30000
# Ngắt client chậm khi hàng đợi WebSocket vượt ngưỡng này (bytes), tránh VPS
# tích bộ nhớ vô hạn. Client sẽ reconnect và refetch dữ liệu active.
WS_MAX_BUFFERED_BYTES=524288
# URL public dùng khi đăng challenge lên confession; để trống sẽ tạo link tương đối.
PUBLIC_APP_URL=
# Chặn lookup profile BDU bị treo để WebSocket trả AUTH_UNAVAILABLE/1013 và
# reconnect theo backoff, thay vì giữ socket authentication vô thời hạn.
BDU_PROFILE_TIMEOUT_MS=20000
# Token opaque khôi phục sau restart chỉ cache kết quả xác minh BDU trong thời
# gian ngắn này; token đăng nhập mới vẫn dùng expires_in chính thức từ BDU.
BDU_RESTORED_TOKEN_TTL_MS=300000

# Tài khoản dịch vụ chỉ đọc dữ liệu CDS BDU. Không dùng tài khoản sinh viên.
CDS_USER=
CDS_PASSWORD=
CDS_INSECURE_TLS=false

# Snapshot xếp hạng chạy mỗi ngày lúc 03:00 Asia/Ho_Chi_Minh.
RANKING_SYNC_ENABLED=true
RANKING_SYNC_HOUR=3
RANKING_SYNC_TIMEOUT_MS=180000
RANKING_MIN_STUDENT_COUNT=100

# Tùy chọn: khóa mới nhất; bỏ trống để tự nhận diện, tối thiểu K29.
RANKING_LATEST_COHORT=
