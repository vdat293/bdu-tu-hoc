# Production Docker Compose PostgreSQL settings.
# Use a URL-safe password because it is embedded in DATABASE_URL.
POSTGRES_DB=bdu_hub
POSTGRES_USER=bdu_hub
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# PostgreSQL (local npm run dev)
DATABASE_URL=postgresql://bdu_hub:replace-this-password@localhost:5432/bdu_hub
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
SYSTEM_OWNER_MSSV=
# Secret riêng cho Admin Dashboard key login (tạo: openssl rand -base64 32).
# Bắt buộc nếu muốn dùng đăng nhập bằng key; MSSV owner KHÔNG phải mật khẩu.
ADMIN_DASHBOARD_KEY=
AVATAR_STORAGE_DIR=./data/avatars
AVATAR_MAX_SIZE_MB=3

# WebSocket: giữ trống khi frontend cùng origin. Với frontend ở origin khác,
# liệt kê origin công khai, ngăn cách bằng dấu phẩy (ví dụ https://hub.example.edu.vn).
WS_ALLOWED_ORIGINS=
# Chỉ bật khi cổng Node chỉ nhận traffic từ reverse proxy tin cậy. Proxy phải
# chuyển tiếp X-Forwarded-Host hoặc header Forwarded có host công khai.
WS_TRUST_PROXY=
# Thời gian chờ client gửi auth trước khi đóng socket. Một lần xác thực đang
# gọi BDU vẫn được phép hoàn tất; lỗi BDU tạm thời sẽ trả 1013 để client retry.
WS_AUTH_TIMEOUT_MS=30000
# Ngắt client chậm khi hàng đợi WebSocket vượt ngưỡng này (bytes), tránh VPS
# tích bộ nhớ vô hạn. Client sẽ reconnect và refetch dữ liệu active.
WS_MAX_BUFFERED_BYTES=524288
# Thời gian ân hạn (ms) trước khi phòng đấu bị đóng vì người chơi mất kết nối
# WebSocket. Đủ dài để F5 hoặc rớt mạng chớp nhoáng không phá ván đấu.
GAME_DISCONNECT_GRACE_MS=30000
# URL public dùng khi đăng challenge lên confession; để trống sẽ tạo link tương đối.
PUBLIC_APP_URL=
# Chặn lookup profile BDU bị treo để WebSocket trả AUTH_UNAVAILABLE/1013 và
# reconnect theo backoff, thay vì giữ socket authentication vô thời hạn.
BDU_PROFILE_TIMEOUT_MS=20000
# Token opaque khôi phục sau restart chỉ cache kết quả xác minh BDU trong thời
# gian ngắn này; token đăng nhập mới vẫn dùng expires_in chính thức từ BDU.
BDU_RESTORED_TOKEN_TTL_MS=300000

# Tài khoản dịch vụ chỉ đọc dữ liệu CDS BDU. Không dùng tài khoản sinh viên.
CDS_USER=
CDS_PASSWORD=
CDS_INSECURE_TLS=false

# Snapshot xếp hạng chạy mỗi ngày lúc 03:00 Asia/Ho_Chi_Minh.
RANKING_SYNC_ENABLED=true
RANKING_SYNC_HOUR=3
RANKING_SYNC_TIMEOUT_MS=180000
RANKING_MIN_STUDENT_COUNT=100

# Tùy chọn: khóa mới nhất; bỏ trống để tự nhận diện, tối thiểu K29.
RANKING_LATEST_COHORT=

# ---------------------------------------------------------------------------
# Kéo bài viết từ nhóm Facebook (BDU Confessions) về bảng tin Confession.
#
# Cách bật:
#   1. npm run fb:login   -> mở Chrome thật, đăng nhập Facebook có quyền xem nhóm
#   2. Đặt FB_IMPORT_ENABLED=true rồi khởi động lại server
#
# Cookie phiên nằm trong FB_IMPORT_PROFILE_DIR; đừng commit thư mục này.
# Facebook không còn Groups API nên tính năng này đọc feed bằng trình duyệt;
# tài khoản có thể bị checkpoint nếu chạy quá dày — nên để >= 15 phút/lượt.
FB_IMPORT_ENABLED=false
FB_IMPORT_GROUP_URL=https://www.facebook.com/groups/bdu.confessions
FB_IMPORT_INTERVAL_MINUTES=20
FB_IMPORT_MAX_SCROLLS=6
FB_IMPORT_MAX_POSTS_PER_RUN=10
# Ngừng cuộn khi gặp liên tiếp ngần này bài đã nhập (đã tới vùng cũ).
FB_IMPORT_MAX_DUPLICATES=5
# Chờ thêm sau lần cuộn cuối để vét nốt response GraphQL về muộn (ms).
FB_IMPORT_SETTLE_DELAY_MS=4000
FB_IMPORT_MAX_POST_AGE_DAYS=30
FB_IMPORT_DOWNLOAD_MEDIA=true
FB_IMPORT_PROFILE_DIR=./data/fb-profile
FB_IMPORT_MEDIA_DIR=./data/fb-import
# Salt cho bút danh facebook_user_<hash>; đổi salt sẽ đổi toàn bộ bút danh cũ.
FB_IMPORT_HASH_SALT=doi-salt-nay-tren-production
# Docker image production đã kèm Chromium do Playwright quản lý. Giữ trống để
# dùng binary đó; chỉ điền khi cần dùng Chrome/Edge có sẵn trên máy riêng.
FB_IMPORT_BROWSER_CHANNEL=
FB_IMPORT_EXECUTABLE_PATH=
FB_IMPORT_HEADLESS=true

# Tự đăng nhập lại khi cookie hết hạn.
#
# CẢNH BÁO: mật khẩu nằm dạng chữ trong .env — ai đọc được file/backup là đọc
# được mật khẩu. Nếu bắt buộc dùng, nên tạo tài khoản Facebook riêng chỉ để xem
# nhóm, và bật 2FA ở nơi khác. Facebook rất hay chặn đăng nhập tự động
# (checkpoint/unusual activity), nên đây chỉ là phương án dự phòng: khi bị chặn
# vẫn phải chạy `npm run fb:login` để xử lý thủ công.
FB_IMPORT_USERNAME=
FB_IMPORT_PASSWORD=
FB_IMPORT_AUTO_RELOGIN=true
# Sau bao nhiêu lần thất bại liên tiếp thì ngừng thử (tránh bị khoá tài khoản).
FB_IMPORT_RELOGIN_MAX_ATTEMPTS=2
FB_IMPORT_RELOGIN_COOLDOWN_MINUTES=360

# ---------------------------------------------------------------------------
# Nhắc lịch học opt-in qua Email/Discord.
# Mặc định TẮT. Chỉ khi user bật + xac_nhan=true mới snapshot + lưu vault.
# Tạo key: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=
# Discord bot (https://discord.com/developers → New Application → Bot → Reset Token)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 1-click: OAuth2 → Reset Secret + thêm Redirect dưới vào Redirects.
# Dev: http://localhost:3000/discord-callback
# Prod (vd sv.bdu.io.vn): https://sv.bdu.io.vn/discord-callback
# Code tự lấy theo DISCORD_REDIRECT_URI → APP_URL/PUBLIC_APP_URL → localhost.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# ID server test để đăng lệnh guild cho nhanh (dev). Prod để trống → lệnh global.
DISCORD_GUILD_ID=
# Link mời vào server nhận tin (hiện trong popup khi DM bị chặn). Bỏ trống = ẩn nút.
DISCORD_INVITE_URL=
# Email dev: Gmail App Password. Prod: SES/Resend + domain riêng.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Giữ chunk JS/CSS của bản build trước trong volume (mặc định data/client-assets)
# để HTML còn cache không 404 sau deploy. Bật mặc định; đặt
# CLIENT_ASSET_HISTORY_ENABLED=false để tắt.
CLIENT_ASSET_HISTORY_DIR=
CLIENT_ASSET_HISTORY_DAYS=30
